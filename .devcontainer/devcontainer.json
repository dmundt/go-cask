{
  "name": "Go Cask Development",
  "image": "mcr.microsoft.com/devcontainers/base:debian13",
  "features": {
    "ghcr.io/devcontainers/features/go:1.4.0": {
      // Match the repository toolchain and lint gate pins.
      "version": "1.27.1",
      "golangciLintVersion": "2.14.0",
      "installGoTools": true
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "2.102.0"
    },
    "ghcr.io/devcontainers/features/powershell:2.0.3": {
      // Pin the latest LTS release; update deliberately.
      "version": "7.6.6"
    },
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "os-provided",
      // Use Python from the base image; do not install the feature's extra tools.
      "installTools": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github"
      ]
    }
  },
  "forwardPorts": [
    // Maintenance tool's default web server port.
    8080
  ]
}

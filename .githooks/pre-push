#!/bin/sh
# Mechanical landing rules (AGENTS.md, "The pull request is the lane"):
#
#   1. the gate ran green for the exact commit being pushed — and because the
#      stamp is keyed by commit, re-pushing an unchanged commit costs nothing;
#   2. the lane itself is the open pull request, claimed on the remote
#      (`refs/lane/<issue>`), so this hook only REPORTS the local advisory slot.
#      Holding it is no longer a condition for pushing.
#
# Both rules live in `cmd/buildtool pre-push`, where they have tests. The hook only starts
# the build tool from the checkout that holds it, through the same entry point every other
# caller uses, and names the repository being pushed so the tool reads that repository's
# ledger rather than its own — which also means the hook resolves Go the way the gate does,
# rather than assuming a `go` on this shell's PATH.
#
# Install once per clone:  git config core.hooksPath .githooks
set -eu

pushed=$(git rev-parse --show-toplevel)
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
exec sh "$root/scripts/buildtool.sh" pre-push --repo "$pushed" --remote "${1:-origin}"
